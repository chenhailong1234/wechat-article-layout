# Limyai API key. Never commit a real key.
WECHAT_API_KEY=replace_with_your_key

# Optional: custom publisher script and Chrome executable.
# WECHAT_PUBLISHER_SCRIPT=C:\path\to\wechat_api.py
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional multi-account configuration consumed by your own orchestration layer.
# WECHAT_API_KEY_ACCOUNT_1=replace_with_account_1_key
# WECHAT_API_KEY_ACCOUNT_2=replace_with_account_2_key
